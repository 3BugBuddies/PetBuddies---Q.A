    {
      "name": "CTA-03: Cadastrar Tutor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status de sucesso (200 ou 201)\", () =>\r\n    pm.expect([200, 201]).to.include(pm.response.code));\r\npm.test(\"Responde em menos de 2s\", () =>\r\n    pm.expect(pm.response.responseTime).to.be.below(2000));\r\nconst body = pm.response.json();\r\npm.test(\"Retorna id\", () => pm.expect(body).to.have.property(\"id\"));\r\npm.environment.set(\"tutorId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
