  "item": [
    {
      "name": "CTA-01: Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Responde em menos de 2s\", () =>\r\n    pm.expect(pm.response.responseTime).to.be.below(2000));\r\nconst body = pm.response.json();\r\nconst token = body.token || body.accessToken;\r\npm.test(\"Retorna token JWT\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);\r\npm.environment.set(\"token\", token);\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"login\": \"{{emailVet}}\",\r\n  \"senha\": \"{{senhaVet}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
