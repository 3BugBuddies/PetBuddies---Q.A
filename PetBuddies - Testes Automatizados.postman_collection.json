            "exec": [
              "pm.test(\"Acesso negado (401 ou 403)\", () =>\r\n    pm.expect([401, 403]).to.include(pm.response.code));\r\npm.test(\"Não retorna token\", () =>\r\n    pm.expect(pm.response.text()).to.not.include(\"token\"));\r\n    "
            ]
          }
        }
      ],
